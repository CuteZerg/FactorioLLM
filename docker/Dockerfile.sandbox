# Base image pinned by digest for reproducible, tamper-evident builds (python:3.12-slim, 2026-10).
# To update: docker buildx imagetools inspect python:3.12-slim
FROM python:3.12-slim@sha256:a0f57064cbdcd6285fa45f51237ab0b35ea8ebaed06a1f5973e89e19dfb86704

# Prevent Python from writing .pyc files and enable unbuffered output
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Install factorio-draftsman matching project version
RUN pip install --no-cache-dir factorio-draftsman==3.3.1

# Create an unprivileged user for security
RUN useradd -m -u 1000 -s /bin/bash sandbox
USER sandbox
WORKDIR /home/sandbox
